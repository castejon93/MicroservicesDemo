<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      RabbitMQ.Client is needed in the WebAPI layer only because Program.cs
      registers IConnection directly. If you extract that registration into
      an Infrastructure extension method (AddNotificationsInfrastructure()),
      you can remove this reference from the WebAPI project.
    -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Notifications.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Notifications.Infrastructure.csproj" />
  </ItemGroup>

</Project>
