<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.Extensions.Hosting provides IHostedService / BackgroundService,
      which is the base class for our RabbitMQ consumer background workers.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />

    <!--
      RabbitMQ.Client is the official .NET AMQP client library.
      Version must be kept in sync with the Products service so both sides
      speak the same wire protocol and API surface.
    -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Notifications.Application.csproj" />
    <ProjectReference Include="..\Domain\Notifications.Domain.csproj" />
  </ItemGroup>

</Project>
